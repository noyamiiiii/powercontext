# ---------------------------------------------------------------------------
# Server / seekdb (server-side only, never exposed to the browser)
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# seekdb runs embedded, inside the Node process: no daemon to install.
SEEKDB_PATH=./data/seekdb
SEEKDB_DATABASE=mini_kb

# One collection per knowledge base: ${COLLECTION_PREFIX}${kb}
COLLECTION_PREFIX=kb_
DEFAULT_KB=default

# ---------------------------------------------------------------------------
# Embedding model (must match the model the browser loads)
# ---------------------------------------------------------------------------
# bge-small-zh-v1.5 -> 512 dims, strong on Chinese, 24M params, ONNX available.
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_DIM=512
# bge-zh is asymmetric: queries carry an instruction prefix, documents do not.
QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ---------------------------------------------------------------------------
# Full-text index inside seekdb (ngram handles CJK without a dictionary)
# ---------------------------------------------------------------------------
FULLTEXT_ANALYZER=ngram
FULLTEXT_TOKEN_SIZE=2

# ---------------------------------------------------------------------------
# Index refresh policy: always | deferred | manual
#   always   - refresh right after every write batch (simplest, most correct)
#   deferred - refresh lazily before the next search after new writes
#   manual   - only when POST /api/kbs/:kb/refresh is called
# ---------------------------------------------------------------------------
REFRESH_MODE=always

# ---------------------------------------------------------------------------
# Limits & misc
# ---------------------------------------------------------------------------
MAX_DOCUMENTS_PER_REQUEST=256
MAX_DOCUMENT_CHARS=8000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
